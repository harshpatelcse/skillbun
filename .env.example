NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
# Local development can use the Firebase project hostname below.
# Production: use skillbun.tech (skillbun.vercel.app redirects there).
# Authorize skillbun.tech in Firebase Auth and register
# https://skillbun.tech/__/auth/handler in the Google OAuth client's redirect URIs.
# NEXT_PUBLIC_* changes require a rebuild/redeploy; /__/auth/* is proxied by Next.js.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_web_app_id

# Optional Firebase web app values.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XTFMS5Q59C
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XTFMS5Q59C

GEMINI_API_KEY=your_gemini_api_key
GEMINI_TIMEOUT_MS=20000
GEMINI_RATE_LIMIT_PER_MINUTE=12
GEMINI_RATE_LIMIT_PER_HOUR=80
GEMINI_MAX_RETRIES=2

# High-Speed Distributed Rate Limiting (Upstash Redis / Vercel KV REST)
# Enables sub-5ms atomic sliding window rate limits across serverless instances
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional server-only backup for quiz, Bun-Bot and AI email drafts.
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=z-ai/glm-5.3-free
# Keep auto to retain the provider fallback chain. Bun-Bot also accepts tokenrouter.
COUNSELLOR_AI_PROVIDER=auto

# Optional: keep disabled during development; set TURNSTILE_ENABLED=true when ready.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENABLED=false

# Recommended in production.
HUMAN_PROOF_SECRET=generate_a_long_random_secret
HUMAN_PROOF_TTL_MS=1800000
# Optional dedicated OTP HMAC secret (at least 32 random characters).
# If empty, email signup uses the explicit HUMAN_PROOF_SECRET, also >=32 characters.
# No email signup is allowed without a strong secret and durable Firestore access.
SIGNUP_OTP_SECRET=

# Required in production for security-sensitive absolute links and canonical metadata.
NEXT_PUBLIC_APP_URL=https://skillbun.tech
APP_ORIGIN=https://skillbun.tech
APP_ALLOWED_ORIGINS=https://skillbun.tech,https://skillbun.vercel.app

# Server-only Firebase Admin credentials (supports both FIREBASE_ADMIN_* and FIREBASE_* aliases).
FIREBASE_ADMIN_PROJECT_ID=your_firebase_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=your_firebase_admin_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=your_firebase_admin_private_key_with_escaped_newlines

# Optional Admin email authorization list (comma-separated).
ADMIN_EMAILS=harsh@skillbun.tech

# Optional custom password-reset mailer.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=noreply@skillbun.tech
ZOHO_SMTP_PASS=your_zoho_app_password
PASSWORD_RESET_FROM=SkillBun <noreply@skillbun.tech>

# Study guide encryption key (AES-256, 64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOCS_ENCRYPTION_KEY=your_64_char_hex_encryption_key

# Workforce credentials encryption key (AES-256, 64 hex chars = 32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKFORCE_ENCRYPTION_KEY=your_64_char_hex_workforce_encryption_key

# Optional LinkedIn Company/Organization ID for certificate auto-matching.
NEXT_PUBLIC_LINKEDIN_ORGANIZATION_ID=


# PostHog Product Analytics Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host


