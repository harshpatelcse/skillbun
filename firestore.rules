rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function optionalString(field, maxLength) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLength);
    }

    function optionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    function optionalTimestamp(field) {
      return !(field in request.resource.data) || request.resource.data[field] is timestamp;
    }

    function validProviderList() {
      return !('providers' in request.resource.data) ||
        (request.resource.data.providers is list && request.resource.data.providers.size() <= 20);
    }

    function userProfileKeys() {
      return [
          'uid',
          'email',
          'displayName',
          'photoURL',
          'name',
          'fullName',
          'degree',
          'year',
          'current_year',
          'interest',
          'interest_area',
          'emailVerified',
          'providers',
          'createdAt',
          'updatedAt', 'ageBand'
        ];
    }

    function validUserProfile(uid) {
      return request.resource.data.uid == uid &&
        optionalString('email', 254) &&
        optionalString('displayName', 120) &&
        optionalString('photoURL', 2048) &&
        optionalString('name', 80) &&
        optionalString('fullName', 80) &&
        optionalString('degree', 120) &&
        optionalString('year', 80) &&
        optionalString('current_year', 80) &&
        optionalString('interest', 120) &&
        optionalString('interest_area', 120) &&
        optionalBool('emailVerified') &&
        (!('ageBand' in request.resource.data) || (request.resource.data.ageBand == '18-plus')) &&
        validProviderList() &&
        optionalTimestamp('createdAt') &&
        optionalTimestamp('updatedAt');
    }

    function validProgress(slug) {
      return slug.matches('^[a-z0-9_]{1,80}$') &&
        request.resource.data.keys().hasOnly(['slug', 'completedNodeIds', 'updatedAt']) &&
        request.resource.data.slug == slug &&
        request.resource.data.completedNodeIds is list &&
        request.resource.data.completedNodeIds.size() <= 800 &&
        optionalTimestamp('updatedAt');
    }

    function signedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true &&
        !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') is string && (
            request.auth.token.email.lower() == 'harsh@skillbun.tech' ||
            (exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())) &&
              get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('active', true) != false)
          ))
      );
    }

    function isEmployeeOwner(email) {
      return signedIn() && 
        request.auth.token.get('email_verified', false) == true &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() == email.lower();
    }

    match /users/{uid} {
      allow read, delete: if signedInAs(uid) || isAdmin();
      allow create: if !exists(/databases/$(database)/documents/accountDeletions/$(uid)) &&
        ((signedInAs(uid) && request.resource.data.keys().hasOnly(userProfileKeys()) && validUserProfile(uid)) || isAdmin());
      allow update: if !exists(/databases/$(database)/documents/accountDeletions/$(uid)) &&
        ((signedInAs(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userProfileKeys()) && validUserProfile(uid)) || isAdmin());

      match /roadmapProgress/{slug} {
        allow read, delete: if signedInAs(uid) || isAdmin();
        allow create, update: if !exists(/databases/$(database)/documents/accountDeletions/$(uid)) &&
          ((signedInAs(uid) && validProgress(slug)) || isAdmin());
      }

      match /quizAttempts/{slug} {
        allow read: if signedInAs(uid) || isAdmin();
        allow write: if false; // Authoritative cooldown history is server-owned.
      }
    }

    match /certificates/{certId} {
      // Public verification uses the sanitized server API; raw identity fields stay private.
      allow get: if isAdmin() || signedInAs(resource.data.uid);
      allow list: if isAdmin() || signedInAs(resource.data.uid); // Owners must query by their own uid.
      allow write: if false; // Certificates must only be minted via authenticated backend API (/api/certify/mint)
    }

    match /examAttempts/{attemptId} {
      allow read: if false; // Includes the answer key; only server routes may read it.
      allow write: if false; // Server-side backend API evaluation only
    }

    match /emailSignupChallenges/{challengeId} {
      allow read, write: if false; // OTP state is exclusively managed by the trusted server.
    }

    match /accountDeletions/{uid} {
      allow read, write: if false; // Server-only resumable erasure and stale-session guard.
    }

    // Workforce Hub: Employees collection (Admin full CRUD; Intern read-only on their own record)
    match /employees/{employeeId} {
      allow read: if isAdmin() || (
        signedIn() && 
        resource != null && 
        isEmployeeOwner(resource.data.personal_email)
      );
      allow write: if isAdmin();
    }

    function activeMilestoneOwner(data) {
      let employee = get(/databases/$(database)/documents/employees/$(data.employee_id));
      return isEmployeeOwner(data.employee_email) && employee.data.status in ['ACTIVE', 'EXTENDED'] &&
        employee.data.get('portal_access_revoked', false) != true && isEmployeeOwner(employee.data.personal_email);
    }

    function validInternMilestoneUpdate() {
      return request.resource.data.status in ['TODO', 'IN_PROGRESS', 'UNDER_REVIEW', 'COMPLETED'] &&
        request.resource.data.get('deliverable_url', '') is string && request.resource.data.get('deliverable_url', '').size() <= 500 &&
        (request.resource.data.get('deliverable_url', '') == '' || request.resource.data.get('deliverable_url', '').matches('^https?://[^\\s]+$')) &&
        request.resource.data.updated_at is timestamp && request.resource.data.updated_at == request.time;
    }

    // Workforce Hub: Milestones collection (Admin full CRUD; Intern can read and update only status, deliverable_url, updated_at)
    match /milestones/{milestoneId} {
      allow read: if isAdmin() || (
        signedIn() && 
        resource != null && 
        activeMilestoneOwner(resource.data)
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        resource != null &&
        activeMilestoneOwner(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliverable_url', 'updated_at']) && validInternMilestoneUpdate()
      );
    }

    // Workforce Hub: Workforce Audit Documents collection (Admin full CRUD; Intern read-only on issued docs)
    match /workforce_docs/{docId} {
      allow read: if isAdmin() || (
        signedIn() && 
        resource != null && 
        isEmployeeOwner(resource.data.metadata_snapshot.personal_email)
      );
      allow write: if isAdmin();
    }

    // Admin RBAC Registry collection: Managed directly by founder in database
    match /admins/{adminEmail} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.get('email_verified', false) == true && request.auth.token.email.lower() == adminEmail);
      allow write: if isAdmin();
    }
  }
}
